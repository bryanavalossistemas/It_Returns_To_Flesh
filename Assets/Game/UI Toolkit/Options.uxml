<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Game/UI%20Toolkit/UnityThemes/Global.uss?fileID=7433441132597879392&amp;guid=67e949d355c7e2b498e9f05290b5a9df&amp;type=3#Global"/>
    <ui:VisualElement name="canvas" style="position: absolute; top: 0; left: 0; bottom: 0; right: 0; background-color: rgb(128, 128, 128); justify-content: center; align-items: center;">
        <ui:Button text="X" name="btn_close" style="background-color: rgb(255, 0, 0); -unity-font-style: bold; font-size: 30px; position: absolute; right: 0;"/>
        <ui:Label text="Label" name="title" class="h1">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GUID:0192e1361fd12bf4fae5982baa4c223e" entry="Id(205446223364096)"/>
            </Bindings>
        </ui:Label>
        <ui:VisualElement name="volumes" style="flex-grow: 1;">
            <ui:Label text="Volumes" class="h2"/>
            <ui:Label text="General"/>
            <ui:SliderInt label="" value="42" high-value="100" name="vol_master"/>
            <ui:Label text="BGM"/>
            <ui:SliderInt label="" value="42" high-value="100" name="vol_bgm"/>
            <ui:Label text="SFX"/>
            <ui:SliderInt label="" value="42" high-value="100" name="vol_sfx"/>
        </ui:VisualElement>
        <ui:VisualElement name="languages" style="flex-grow: 1;">
            <ui:Label text="Select language" class="h2"/>
            <ui:DropdownField label="Language" name="drop_languages"/>
        </ui:VisualElement>
        <ui:Image source="project://database/Assets/Game/Visuals/Sprites/Civilian.png?fileID=1870342073269972480&amp;guid=13f839d28f8ca2349bf60492a74d67ec&amp;type=3#Vagabundo_0"/>
    </ui:VisualElement>
</ui:UXML>
